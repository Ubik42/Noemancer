+static bool D3D12_INTERNAL_TrackTimestampPool(
+    D3D12CommandBuffer *commandBuffer,
+    D3D12TimestampQueryPool *pool)
+{
+    for (Uint32 i = 0; i < commandBuffer->timestampPoolCount; i += 1) {
+        if (commandBuffer->timestampPools[i] == (SDL_GPUTimestampQueryPool *)pool) {
+            return true;
+        }
+    }
+    if (commandBuffer->timestampPoolCount >= commandBuffer->timestampPoolCapacity) {
+        Uint32 newCapacity = commandBuffer->timestampPoolCapacity
+            ? commandBuffer->timestampPoolCapacity * 2
+            : 4;
+        SDL_GPUTimestampQueryPool **resized = (SDL_GPUTimestampQueryPool **)SDL_realloc(
+            commandBuffer->timestampPools,
+            newCapacity * sizeof(SDL_GPUTimestampQueryPool *));
+        if (!resized) {
+            SDL_SetError("Failed to track GPU timestamp query pool");
+            return false;
+        }
+        commandBuffer->timestampPools = resized;
+        commandBuffer->timestampPoolCapacity = newCapacity;
+    }
+    commandBuffer->timestampPools[commandBuffer->timestampPoolCount] =
+        (SDL_GPUTimestampQueryPool *)pool;
+    commandBuffer->timestampPoolCount += 1;
+    return true;
+}
