+static void D3D12_ReleaseTimestampQueryPool(
+    SDL_GPURenderer *driverData,
+    SDL_GPUTimestampQueryPool *timestampPool)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12TimestampQueryPool *pool = (D3D12TimestampQueryPool *)timestampPool;
+
+    if (pool == NULL) {
+        return;
+    }
+    if (pool->lastFence != NULL &&
+        ID3D12Fence_GetCompletedValue(pool->lastFence->handle) != pool->lastFenceValue) {
+        SDL_SetError("GPU timestamp query pool is still referenced by a submitted command buffer");
+        return;
+    }
+    if (pool->lastFence != NULL) {
+        D3D12_ReleaseFence(driverData, (SDL_GPUFence *)pool->lastFence);
+        pool->lastFence = NULL;
+    }
+    if (pool->readbackBuffer != NULL) {
+        ID3D12Resource_Release(pool->readbackBuffer);
+    }
+    if (pool->queryHeap != NULL) {
+        ID3D12QueryHeap_Release(pool->queryHeap);
+    }
+    (void)renderer;
+    SDL_free(pool);
+}
