+
+static bool VULKAN_GetTimestampQueryResults(
+    SDL_GPURenderer *driverData,
+    SDL_GPUTimestampQueryPool *timestampPool,
+    Uint32 first_query,
+    Uint32 query_count,
+    Uint64 *values,
+    bool *available)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanTimestampQueryPool *pool = (VulkanTimestampQueryPool *)timestampPool;
+    Uint64 *scratch;
+    VkResult result;
+
+    *available = false;
+    if (renderer->vkGetQueryPoolResults == NULL) {
+        SET_STRING_ERROR_AND_RETURN("Vulkan query result readback is unavailable", false);
+    }
+
+    scratch = (Uint64 *)SDL_malloc((size_t)query_count * sizeof(Uint64));
+    if (!scratch) {
+        return false;
+    }
+    result = renderer->vkGetQueryPoolResults(
+        renderer->logicalDevice,
+        pool->queryPool,
+        first_query,
+        query_count,
+        (size_t)query_count * sizeof(Uint64),
+        scratch,
+        sizeof(Uint64),
+        VK_QUERY_RESULT_64_BIT);
+    if (result == VK_NOT_READY) {
+        SDL_free(scratch);
+        return true;
+    }
+    if (result != VK_SUCCESS) {
+        SDL_free(scratch);
+        CHECK_VULKAN_ERROR_AND_RETURN(result, vkGetQueryPoolResults, false);
+    }
+
+    if (renderer->timestampValidBits < 64) {
+        const Uint64 wrap = (Uint64)1 << renderer->timestampValidBits;
+        const Uint64 mask = wrap - 1;
+        Uint64 epoch = 0;
+        Uint64 previous = scratch[0] & mask;
+        values[0] = previous;
+        for (Uint32 i = 1; i < query_count; i += 1) {
+            Uint64 current = scratch[i] & mask;
+            if (current < previous) {
+                // Vulkan exposes a modulo-2^timestampValidBits counter. The
+                // query range is expected to span at most one wrap.
+                epoch += wrap;
+            }
+            values[i] = current + epoch;
+            previous = current;
+        }
+    } else {
+        SDL_memcpy(values, scratch, (size_t)query_count * sizeof(Uint64));
+    }
+    SDL_free(scratch);
+    *available = true;
+    return true;
+}
