+static bool SDL_GPU_ValidateTimestampCommand(
+    SDL_GPUCommandBuffer *command_buffer,
+    SDL_GPUTimestampQueryPool *pool,
+    Uint32 first_query,
+    Uint32 query_count)
+{
+    CommandBufferCommonHeader *header;
+
+    CHECK_PARAM(command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return false;
+    }
+    CHECK_PARAM(pool == NULL) {
+        SDL_InvalidParamError("pool");
+        return false;
+    }
+    if (query_count == 0) {
+        SDL_InvalidParamError("query_count");
+        return false;
+    }
+
+    header = (CommandBufferCommonHeader *)command_buffer;
+    if (header->device == NULL) {
+        SDL_SetError("Invalid GPU command buffer");
+        return false;
+    }
+    if (pool->device != header->device) {
+        SDL_SetError("GPU timestamp query pool belongs to another device");
+        return false;
+    }
+    if (first_query > pool->query_count ||
+        query_count > pool->query_count - first_query) {
+        SDL_SetError("GPU timestamp query range is out of bounds");
+        return false;
+    }
+
+    if (header->device->debug_mode) {
+        CHECK_COMMAND_BUFFER_RETURN_FALSE
+        CHECK_ANY_PASS_IN_PROGRESS("Cannot record a timestamp query during a pass!", false)
+    }
+    return true;
+}
