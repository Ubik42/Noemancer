+bool FontFaceHandleDefault::ShapeString(StringView string, const TextShapingContext& text_shaping_context, Vector<ShapedGlyph>& result)
+{
+	result.clear();
+	if (string.empty())
+		return true;
+	UErrorCode status = U_ZERO_ERROR;
+	int32_t utf16_length = 0;
+	u_strFromUTF8(nullptr, 0, &utf16_length, string.begin(), (int32_t)string.size(), &status);
+	if (status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status))
+	{
+		++shaping_failures;
+		return false;
+	}
+	status = U_ZERO_ERROR;
+	Vector<UChar> utf16((size_t)utf16_length + 1);
+	u_strFromUTF8(utf16.data(), utf16_length + 1, &utf16_length, string.begin(), (int32_t)string.size(), &status);
+	if (U_FAILURE(status))
+	{
+		++shaping_failures;
+		return false;
+	}
+	utf16.resize((size_t)utf16_length);
+
+	UBiDiLevel paragraph_level = UBIDI_DEFAULT_LTR;
+	if (text_shaping_context.text_direction == Style::Direction::Rtl)
+		paragraph_level = UBIDI_RTL;
+	else if (text_shaping_context.text_direction == Style::Direction::Ltr)
+		paragraph_level = UBIDI_LTR;
+	UBiDi* bidi = ubidi_openSized(utf16_length, 0, &status);
+	if (U_FAILURE(status) || !bidi)
+	{
+		++shaping_failures;
+		return false;
+	}
+	ubidi_setPara(bidi, utf16.data(), utf16_length, paragraph_level, nullptr, &status);
+	const int32_t bidi_run_count = U_SUCCESS(status) ? ubidi_countRuns(bidi, &status) : 0;
+	if (U_FAILURE(status))
+	{
+		ubidi_close(bidi);
+		++shaping_failures;
+		return false;
+	}
+
+	struct FontRun { FontFaceHandleDefault* face; int32_t start; int32_t length; };
+	for (int32_t visual_index = 0; visual_index < bidi_run_count; ++visual_index)
+	{
+		int32_t logical_start = 0;
+		int32_t logical_length = 0;
+		const UBiDiDirection bidi_direction = ubidi_getVisualRun(bidi, visual_index, &logical_start, &logical_length);
+		Vector<FontRun> font_runs;
+		const int32_t logical_end = logical_start + logical_length;
+		for (int32_t offset = logical_start; offset < logical_end;)
+		{
+			const int32_t codepoint_start = offset;
+			UChar32 codepoint = 0;
+			U16_NEXT(utf16.data(), offset, logical_end, codepoint);
+			FontFaceHandleDefault* selected_face = ResolveFace((Character)codepoint);
+			if (!selected_face)
+			{
+				ubidi_close(bidi);
+				++shaping_failures;
+				result.clear();
+				return false;
+			}
+			if (font_runs.empty() || font_runs.back().face != selected_face)
+				font_runs.push_back({selected_face, codepoint_start, offset - codepoint_start});
+			else
+				font_runs.back().length = offset - font_runs.back().start;
+		}
+		if (bidi_direction == UBIDI_RTL)
+			std::reverse(font_runs.begin(), font_runs.end());
+
+		for (const FontRun& run : font_runs)
+		{
+			hb_font_t* font = (hb_font_t*)run.face->GetHarfBuzzFont();
+			if (!font)
+			{
+				ubidi_close(bidi);
+				++shaping_failures;
+				result.clear();
+				return false;
+			}
+			hb_buffer_t* buffer = hb_buffer_create();
+			hb_buffer_add_utf16(buffer, (const uint16_t*)utf16.data(), utf16_length, run.start, run.length);
+			hb_buffer_set_direction(buffer, bidi_direction == UBIDI_RTL ? HB_DIRECTION_RTL : HB_DIRECTION_LTR);
+			hb_buffer_set_language(buffer, hb_language_from_string(text_shaping_context.language.c_str(), (int)text_shaping_context.language.size()));
+			hb_buffer_guess_segment_properties(buffer);
+			hb_shape(font, buffer, nullptr, 0);
+			unsigned int glyph_count = 0;
+			const hb_glyph_info_t* infos = hb_buffer_get_glyph_infos(buffer, &glyph_count);
+			const hb_glyph_position_t* positions = hb_buffer_get_glyph_positions(buffer, &glyph_count);
+			for (unsigned int glyph_index = 0; glyph_index < glyph_count; ++glyph_index)
+			{
+				const Character atlas_key = GetOrAppendShapedGlyph(run.face, infos[glyph_index].codepoint);
+				if (atlas_key == Character::Null)
+				{
+					hb_buffer_destroy(buffer);
+					ubidi_close(bidi);
+					++shaping_failures;
+					result.clear();
+					return false;
+				}
+				const bool end_of_cluster = glyph_index + 1 == glyph_count || infos[glyph_index + 1].cluster != infos[glyph_index].cluster;
+				result.push_back({atlas_key,
+					(int)std::lround((double)positions[glyph_index].x_advance / 64.0) + (end_of_cluster ? (int)text_shaping_context.letter_spacing : 0),
+					(int)std::lround((double)positions[glyph_index].y_advance / 64.0),
+					(int)std::lround((double)positions[glyph_index].x_offset / 64.0),
+					(int)std::lround((double)positions[glyph_index].y_offset / 64.0), infos[glyph_index].cluster});
+			}
+			glyphs_emitted += glyph_count;
+			if (run.face != this)
+				++fallback_runs_shaped;
+			hb_buffer_destroy(buffer);
+		}
+		++visual_runs_shaped;
+	}
+	ubidi_close(bidi);
+	++strings_shaped;
+	return true;
+}
