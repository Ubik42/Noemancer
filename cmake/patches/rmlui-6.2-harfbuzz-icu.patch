+void* FontFaceHandleDefault::GetHarfBuzzFont()
+{
+	if (harfbuzz_font)
+		return harfbuzz_font;
+	FT_Face face = (FT_Face)ft_face;
+	if (!face || !face->stream || !face->stream->base || face->stream->size == 0)
+		return nullptr;
+	hb_blob_t* blob = hb_blob_create((const char*)face->stream->base, (unsigned int)face->stream->size, HB_MEMORY_MODE_READONLY, nullptr, nullptr);
+	hb_face_t* hb_face = hb_face_create(blob, (unsigned int)(face->face_index & 0xffff));
+	hb_blob_destroy(blob);
+	hb_font_t* font = hb_font_create(hb_face);
+	hb_face_destroy(hb_face);
+	hb_ot_font_set_funcs(font);
+	const int scale = metrics.size * 64;
+	hb_font_set_scale(font, scale, scale);
+	hb_font_set_ppem(font, (unsigned int)metrics.size, (unsigned int)metrics.size);
+	harfbuzz_font = font;
+	return harfbuzz_font;
+}
+
+bool FontFaceHandleDefault::HasCharacter(Character character) const
+{
+	return FreeType::HasGlyph(ft_face, character);
+}
+
+FontFaceHandleDefault* FontFaceHandleDefault::ResolveFace(Character character)
+{
+	if (HasCharacter(character))
+		return this;
+	const int fallback_count = FontProvider::CountFallbackFontFaces();
+	for (int index = 0; index < fallback_count; ++index)
+	{
+		FontFaceHandleDefault* fallback = FontProvider::GetFallbackFontFace(index, metrics.size);
+		if (fallback && fallback != this && fallback->HasCharacter(character))
+			return fallback;
+	}
+	return nullptr;
+}
+
+Character FontFaceHandleDefault::GetOrAppendShapedGlyph(FontFaceHandleDefault* source_face, uint32_t glyph_index)
+{
+	if (!source_face || glyph_index == 0)
+		return Character::Null;
+	const auto identity = std::make_pair((uintptr_t)source_face, glyph_index);
+	if (const auto found = shaped_glyph_keys.find(identity); found != shaped_glyph_keys.end())
+		return found->second;
+
+	Character source_key = Character::Null;
+	if (source_face == this)
+	{
+		source_key = (Character)next_shaped_atlas_key++;
+		if (!FreeType::AppendGlyphIndex(ft_face, metrics.size, glyph_index, source_key, glyphs))
+			return Character::Null;
+		is_layers_dirty = true;
+	}
+	else
+	{
+		const Character fallback_key = source_face->GetOrAppendShapedGlyph(source_face, glyph_index);
+		const auto fallback_glyph = source_face->glyphs.find(fallback_key);
+		if (fallback_key == Character::Null || fallback_glyph == source_face->glyphs.end())
+			return Character::Null;
+		source_key = (Character)next_shaped_atlas_key++;
+		glyphs.emplace(source_key, fallback_glyph->second.WeakCopy());
+		is_layers_dirty = true;
+	}
+	shaped_glyph_keys.emplace(identity, source_key);
+	++atlas_glyphs_loaded;
+	return source_key;
+}
